# Pinned component versions. Renovate updates these via customManagers in
# renovate.json. Dockerfiles read the values as build-args.
# CI also publishes prefixed GHCR aliases from these pins (cli-*, git-*, alpine-*);
# chart image tags stay on container releases vX.Y.Z only.

# renovate: datasource=docker depName=alpine
ALPINE_VERSION=3.24.4

# renovate: datasource=docker depName=debian
DEBIAN_VERSION=trixie-slim

# renovate: datasource=github-releases depName=Sendspin/sendspin-cpp-cli
SENDSPIN_CLI_REF=v1.0.1

# ralph-irving/squeezelite has no release tags; pin the git commit on master.
# renovate: datasource=git-refs depName=https://github.com/ralph-irving/squeezelite currentValue=master
SQUEEZELITE_REF=b02a9ac77794c9914fa2b70caa98010e9f23cc2d
